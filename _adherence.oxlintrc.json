{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/acoes/**",
              "components/dados/**",
              "components/estrutura/**",
              "components/feedback/**",
              "components/formulario/**",
              "components/graficos/**",
              "components/navegacao/**",
              "ui_kits/casa-projetos/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='Abas'] > JSXAttribute > JSXIdentifier[name!=/^(?:abas|ativa|aoMudar|style|key|ref|className|style|children)$/]",
        "message": "<Abas> doesn't accept that prop. Declared props: abas, ativa, aoMudar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alerta'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|titulo|children|aoFechar|style|key|ref|className|style|children)$/]",
        "message": "<Alerta> doesn't accept that prop. Declared props: variante, titulo, children, aoFechar, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alerta'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:info|sucesso|atencao|erro)$/]",
        "message": "<Alerta> variante must be one of 'info' | 'sucesso' | 'atencao' | 'erro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AreaTexto'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotulo|valor|aoMudar|placeholder|dica|erro|linhas|obrigatorio|desabilitado|style|key|ref|className|style|children)$/]",
        "message": "<AreaTexto> doesn't accept that prop. Declared props: rotulo, valor, aoMudar, placeholder, dica, erro, linhas, obrigatorio, desabilitado, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:nome|src|tamanho|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: nome, src, tamanho, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aviso'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|titulo|mensagem|aoFechar|style|key|ref|className|style|children)$/]",
        "message": "<Aviso> doesn't accept that prop. Declared props: variante, titulo, mensagem, aoFechar, style."
