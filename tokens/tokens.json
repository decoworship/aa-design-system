{
  "$nome": "AA Design System",
  "$versao": "0.3.0",
  "$descricao": "Fonte única da verdade dos tokens de design. Edite este arquivo primeiro; os demais (tokens.css, preview) derivam dele.",

  "cor": {
    "neutro": {
      "_comentario": "Escala de areia quente — a base calma do sistema.",
      "areia-50":  "#FAF7F1",
      "areia-100": "#F4EFE6",
      "areia-200": "#E9E1D2",
      "areia-300": "#DAD0BC",
      "areia-400": "#C2B69D",
      "areia-500": "#A6987D",
      "areia-600": "#847A63",
      "areia-700": "#5F584A",
      "areia-800": "#3D382F",
      "areia-900": "#221F1A"
    },
    "primaria": {
      "_comentario": "Azul calmo (inspirado no acento dos posters). A cor de ação do sistema.",
      "50":  "#EAEEF4",
      "100": "#CBD6E4",
      "200": "#A9BCD1",
      "300": "#7C95B4",
      "400": "#5B7B9E",
      "500": "#3D6189",
      "600": "#31506F",
      "700": "#26405A",
      "800": "#1B2E41",
      "900": "#131F2C"
    },
    "acento": {
      "_comentario": "Terracota quente — o 'toque de cor'. Usar com parcimônia.",
      "50":  "#F8EFE9",
      "100": "#EFDACE",
      "300": "#DBAA8B",
      "500": "#C57B57",
      "600": "#AC6644",
      "700": "#8A5136"
    },
    "feedback": {
      "_comentario": "Auditado em WCAG 2.1 AA: cada cor passa 4.5:1 como texto sobre seu -bg e como preenchimento sob texto-invertido.",
      "sucesso":      "#4A6746",
      "sucesso-bg":   "#E7EDE4",
      "atencao":      "#8A5F22",
      "atencao-bg":   "#F5EBD8",
      "erro":         "#8E3A2E",
      "erro-bg":      "#F3E0DC",
      "info":         "#3D6189",
      "info-bg":      "#EAEEF4"
    },
    "dados": {
      "_comentario": "Paleta categórica para gráficos de dashboard. Calma mas distinguível.",
      "1": "#3D6189",
      "2": "#C57B57",
      "3": "#6E8E6B",
      "4": "#D0A24E",
      "5": "#8A6E8E",
      "6": "#5E7C8A",
      "7": "#9C6B57",
      "8": "#6B7F5E"
    },
    "sequencial": {
      "_comentario": "Uma única variável, do claro ao escuro. Mapa de calor, densidade, intensidade.",
      "1": "#E4EBF2",
      "2": "#B9CBDD",
      "3": "#8AA6C3",
      "4": "#5B7B9E",
      "5": "#31506F"
    },
    "divergente": {
      "_comentario": "Desvio em torno de um ponto neutro: terracota (abaixo) ↔ azul (acima).",
      "1": "#AC6644",
      "2": "#DBAA8B",
      "3": "#E9E1D2",
      "4": "#8AA6C3",
      "5": "#31506F"
    },
    "grafico": {
      "_comentario": "Cromo do gráfico — nunca use cor de série aqui.",
      "grade":       "#E9E1D2",
      "eixo":        "#DAD0BC",
      "rotulo":      "#5F584A",
      "area":        "rgba(61,97,137,0.14)",
      "realce":      "#C57B57",
      "referencia":  "#A6987D"
    }
  },

  "semantico": {
    "_comentario": "Tokens semânticos: é por estes nomes que você deve se referir às cores no dia a dia, nunca pelo valor cru.",
    "fundo":          "{cor.neutro.areia-100}",
    "superficie":     "{cor.neutro.areia-50}",
    "superficie-2":   "{cor.neutro.areia-200}",
    "borda":          "{cor.neutro.areia-300}",
    "borda-forte":    "{cor.neutro.areia-400}",
    "borda-controle": "{cor.neutro.areia-600}",
    "texto":          "{cor.neutro.areia-800}",
    "texto-suave":    "{cor.neutro.areia-700}",
    "texto-forte":    "{cor.neutro.areia-900}",
    "texto-invertido":"{cor.neutro.areia-50}",
    "_comentario-estados": "Estados de interacao viram token semantico — nunca escala crua dentro do componente. E isso que faz o tema escuro funcionar sem reescrever componente nenhum.",
    "acao-suave":           "{cor.primaria.50}",
    "acao-suave-2":         "{cor.primaria.100}",
    "destaque-bg":          "{cor.acento.50}",
    "borda-controle-hover": "{cor.neutro.areia-700}",
    "linha-hover":          "{cor.neutro.areia-100}",
    "link-sublinhado":      "{cor.primaria.200}",
    "veu":                  "rgba(34,31,26,0.38)"
  },

  "tipografia": {
    "familia": {
      "display": "'Fraunces', Georgia, serif",
      "ui": "'Hanken Grotesk', system-ui, -apple-system, sans-serif",
      "mono": "ui-monospace, 'SF Mono', Menlo, monospace"
    },
    "escala": {
      "heroi":    { "tamanho": "48px", "altura-linha": "1.05", "peso": "600", "familia": "display", "_comentario": "Só em hero de login/marketing. Nunca em dashboard." },
      "display":  { "tamanho": "36px", "altura-linha": "1.1",  "peso": "600", "familia": "display" },
      "titulo-g": { "tamanho": "24px", "altura-linha": "1.25", "peso": "600", "familia": "ui" },
      "titulo-m": { "tamanho": "18px", "altura-linha": "1.35", "peso": "600", "familia": "ui" },
      "corpo":    { "tamanho": "15px", "altura-linha": "1.55", "peso": "400", "familia": "ui" },
      "pequeno":  { "tamanho": "13px", "altura-linha": "1.5",  "peso": "400", "familia": "ui" },
      "rotulo":   { "tamanho": "12px", "altura-linha": "1.4",  "peso": "600", "familia": "ui", "caixa-alta": true, "espacamento-letra": "0.06em" }
    }
  },

  "espacamento": {
    "_comentario": "Base de 4px. Use SEMPRE valores desta escala — nunca um número solto.",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },

  "raio": {
    "pequeno": "6px",
    "medio":   "10px",
    "grande":  "16px",
    "pilula":  "999px"
  },

  "sombra": {
    "pequena": "0 1px 2px rgba(34,31,26,0.06)",
    "media":   "0 4px 12px rgba(34,31,26,0.08)",
    "grande":  "0 12px 28px rgba(34,31,26,0.12)"
  },

  "movimento": {
    "_comentario": "150ms é o padrão. Nada de mola, nada de quique.",
    "rapida": "120ms ease",
    "padrao": "150ms ease",
    "lenta":  "240ms ease"
  },

  "foco": {
    "anel":      "0 0 0 3px var(--primaria-400)",
    "anel-erro": "0 0 0 3px var(--cor-erro)"
  },

  "camada": {
    "base": 0, "suspenso": 100, "cortina": 200, "modal": 300, "aviso": 400
  },

  "layout": {
    "largura-maxima":  "980px",
    "largura-leitura": "64ch",
    "quebra-mobile":   "620px"
  },

  "tema-escuro": {
    "_comentario": "Sobrescreve APENAS os tokens semanticos. As cores cruas nao mudam — e por isso que nenhum componente precisa de ajuste. Base marrom-carvao, nao cinza azulado: areia no escuro continua quente. Ligar com <html data-tema=\"escuro\"> ou \"auto\" para seguir o sistema.",
    "semantico": {
      "fundo":           "#1A1714",
      "superficie":      "#221F1A",
      "superficie-2":    "#2E2A24",
      "borda":           "#322D26",
      "borda-forte":     "#4E483D",
      "borda-controle":  "#7B7362",
      "texto":           "#EDE7DB",
      "texto-suave":     "#B7AC98",
      "texto-forte":     "#FAF7F1",
      "texto-invertido": "#221F1A",
      "acao":            "#8FAECD",
      "acao-hover":      "#A6C0DA",
      "acao-ativa":      "#BDD2E7",
      "destaque":        "#DBAA8B",
      "destaque-texto":  "#E4BFA5",
      "acao-suave":           "#1E2A38",
      "acao-suave-2":         "#26364A",
      "destaque-bg":          "#33251C",
      "borda-controle-hover": "#8A8170",
      "linha-hover":          "#2A2620",
      "link-sublinhado":      "#4F739A",
      "veu":                  "rgba(8,6,4,0.62)"
    },
    "feedback": {
      "sucesso": "#8FB088", "sucesso-bg": "#263024",
      "atencao": "#DCA94E", "atencao-bg": "#33280F",
      "erro":    "#E08172", "erro-bg":    "#3A211C",
      "info":    "#8FAECD", "info-bg":    "#1E2A38"
    },
    "dados": {
      "_comentario": "Mesma ordem e mesmo matiz do tema claro, so mais claros. Ordem e hierarquia: reordenar quebraria a leitura.",
      "1": "#6E9AC8", "2": "#DB9A72", "3": "#8AB185", "4": "#E0BB68",
      "5": "#B292B6", "6": "#82A5B4", "7": "#C4917A", "8": "#93A883"
    },
    "sequencial": {
      "_comentario": "Inverte o sentido: no escuro, 'mais' e mais claro.",
      "1": "#23313F", "2": "#35506B", "3": "#4F739A", "4": "#7C9CBF", "5": "#B4C8DD"
    },
    "divergente": {
      "1": "#DB9A72", "2": "#A6714F", "3": "#3B362E", "4": "#4F739A", "5": "#B4C8DD"
    },
    "grafico": {
      "grade": "#322D26", "eixo": "#4E483D", "rotulo": "#B7AC98",
      "area": "rgba(143,174,205,0.16)", "realce": "#DBAA8B", "referencia": "#7B7362"
    },
    "sombra": {
      "_comentario": "No escuro sombra quase nao separa nada — a separacao real e tom de superficie e borda.",
      "pequena": "0 1px 2px rgba(0,0,0,0.40)",
      "media":   "0 4px 12px rgba(0,0,0,0.45)",
      "grande":  "0 12px 28px rgba(0,0,0,0.55)"
    },
    "foco": {
      "anel":      "0 0 0 3px var(--primaria-300)",
      "anel-erro": "0 0 0 3px var(--cor-erro)"
    }
  }
}
