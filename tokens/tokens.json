{
  "$nome": "AA Design System",
  "$versao": "0.1.0",
  "$descricao": "Fonte única da verdade dos tokens de design. Edite este arquivo primeiro; os demais (tokens.css, preview) derivam dele.",

  "cor": {
    "neutro": {
      "_comentario": "Escala de areia quente — a base calma do sistema.",
      "areia-50":  "#FAF7F1",
      "areia-100": "#F4EFE6",
      "areia-200": "#E9E1D2",
      "areia-300": "#DAD0BC",
      "areia-400": "#C2B69D",
      "areia-500": "#A6987D",
      "areia-600": "#847A63",
      "areia-700": "#5F584A",
      "areia-800": "#3D382F",
      "areia-900": "#221F1A"
    },
    "primaria": {
      "_comentario": "Azul calmo (inspirado no acento dos posters). A cor de ação do sistema.",
      "50":  "#EAEEF4",
      "100": "#CBD6E4",
      "300": "#7C95B4",
      "500": "#3D6189",
      "600": "#31506F",
      "700": "#26405A"
    },
    "acento": {
      "_comentario": "Terracota quente — o 'toque de cor'. Usar com parcimônia.",
      "500": "#C57B57",
      "600": "#AC6644"
    },
    "feedback": {
      "sucesso":      "#5C7E58",
      "sucesso-bg":   "#E7EDE4",
      "atencao":      "#C2893C",
      "atencao-bg":   "#F5EBD8",
      "erro":         "#AE4A3C",
      "erro-bg":      "#F3E0DC",
      "info":         "#3D6189",
      "info-bg":      "#EAEEF4"
    },
    "dados": {
      "_comentario": "Paleta categórica para gráficos de dashboard. Calma mas distinguível.",
      "1": "#3D6189",
      "2": "#C57B57",
      "3": "#6E8E6B",
      "4": "#D0A24E",
      "5": "#8A6E8E",
      "6": "#5E7C8A"
    }
  },

  "semantico": {
    "_comentario": "Tokens semânticos: é por estes nomes que você deve se referir às cores no dia a dia, nunca pelo valor cru.",
    "fundo":          "{cor.neutro.areia-100}",
    "superficie":     "{cor.neutro.areia-50}",
    "superficie-2":   "{cor.neutro.areia-200}",
    "borda":          "{cor.neutro.areia-300}",
    "borda-forte":    "{cor.neutro.areia-400}",
    "texto":          "{cor.neutro.areia-800}",
    "texto-suave":    "{cor.neutro.areia-600}",
    "texto-forte":    "{cor.neutro.areia-900}",
    "texto-invertido":"{cor.neutro.areia-50}"
  },

  "tipografia": {
    "familia": {
      "display": "'Fraunces', Georgia, serif",
      "ui": "'Hanken Grotesk', system-ui, -apple-system, sans-serif"
    },
    "escala": {
      "display":  { "tamanho": "36px", "altura-linha": "1.1",  "peso": "600", "familia": "display" },
      "titulo-g": { "tamanho": "24px", "altura-linha": "1.25", "peso": "600", "familia": "ui" },
      "titulo-m": { "tamanho": "18px", "altura-linha": "1.35", "peso": "600", "familia": "ui" },
      "corpo":    { "tamanho": "15px", "altura-linha": "1.55", "peso": "400", "familia": "ui" },
      "pequeno":  { "tamanho": "13px", "altura-linha": "1.5",  "peso": "400", "familia": "ui" },
      "rotulo":   { "tamanho": "12px", "altura-linha": "1.4",  "peso": "600", "familia": "ui", "caixa-alta": true, "espacamento-letra": "0.06em" }
    }
  },

  "espacamento": {
    "_comentario": "Base de 4px. Use SEMPRE valores desta escala — nunca um número solto.",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },

  "raio": {
    "pequeno": "6px",
    "medio":   "10px",
    "grande":  "16px",
    "pilula":  "999px"
  },

  "sombra": {
    "pequena": "0 1px 2px rgba(34,31,26,0.06)",
    "media":   "0 4px 12px rgba(34,31,26,0.08)",
    "grande":  "0 12px 28px rgba(34,31,26,0.12)"
  }
}
